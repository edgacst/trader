<Window x:Class="StockCasterLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgarCaster Live 1.1.4"
        Width="1140" Height="740"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#162033"/>
        <SolidColorBrush x:Key="Muted" Color="#748096"/>
        <SolidColorBrush x:Key="Line" Color="#E3E8F0"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E9F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.06" Color="#182230"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3C485C"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="Input" TargetType="Control">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="Background" Value="#F9FAFC"/>
            <Setter Property="BorderBrush" Value="#DCE2EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ButtonBase" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6DDE8"/>
            <Setter Property="Foreground" Value="#344054"/>
        </Style>

        <Style x:Key="RecordingStartButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="#FFF2F4"/>
            <Setter Property="BorderBrush" Value="#F2CCD2"/>
            <Setter Property="Foreground" Value="#9D3443"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RecordingStartBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RecordingStartBorder" Property="Background" Value="#FFE8EC"/>
                                <Setter TargetName="RecordingStartBorder" Property="BorderBrush" Value="#EFB5BF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RecordingStartBorder" Property="Background" Value="#FFDEE4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#987C81"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                                <Setter TargetName="RecordingStartBorder" Property="Background" Value="#FFF5F6"/>
                                <Setter TargetName="RecordingStartBorder" Property="BorderBrush" Value="#F0DDE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrivacyToggle" TargetType="ToggleButton">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A5A00"/>
            <Setter Property="Background" Value="#FFF8E6"/>
            <Setter Property="BorderBrush" Value="#F5D489"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#E8B84E"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#FFF0C7"/>
                                <Setter Property="BorderBrush" Value="#F2B632"/>
                                <Setter Property="Foreground" Value="#714500"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StartButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6157F1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#635BFF" Offset="0"/>
                        <GradientStop Color="#8B5CF6" Offset="0.55"/>
                        <GradientStop Color="#EC4899" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StopButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#B4233E"/>
            <Setter Property="BorderBrush" Value="#FFB8C5"/>
            <Setter Property="Background" Value="#FFF0F3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="38"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#171A35" Offset="0"/>
                    <GradientStop Color="#332C69" Offset="0.56"/>
                    <GradientStop Color="#5C3775" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#26FFFFFF"
                            BorderBrush="#38FFFFFF" BorderThickness="1">
                        <Grid>
                            <Path Data="M 9,26 L 16,18 L 22,22 L 31,11" Stroke="#7CF6D2" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Ellipse Width="7" Height="7" Fill="#FF7CB3" HorizontalAlignment="Right"
                                     VerticalAlignment="Top" Margin="0,7,7,0"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="EdgarCaster Live 1.1.4" Foreground="White" FontSize="18" FontWeight="Bold"
                               Margin="13,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Grid.Column="1" Padding="12,6" CornerRadius="15" Background="#1BFFFFFF"
                        BorderBrush="#34FFFFFF" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusDot" Width="8" Height="8" Fill="#7CF6D2" Margin="0,0,7,0"/>
                        <TextBlock x:Name="HeaderStatusText" Text="방송 준비" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="96"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0,4,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="방송 미리보기" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                <Border x:Name="PreviewBadge" Background="#EEF0FF" CornerRadius="8" Padding="7,3" Margin="9,0,0,0">
                                    <TextBlock x:Name="PreviewBadgeText" Text="대기" Foreground="#5D57D9" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="PreviewInfoText" Text="소스를 선택하세요"
                                       Foreground="{StaticResource Muted}" FontSize="10.5" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#101522" CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <!-- UniformToFill이 아닌 Uniform을 사용한다: 실제 방송(ffmpeg)은 캡처한 프레임을
                                     자르지 않고 전체를 그대로 내보내므로, 미리보기도 잘라내지 않고 전체를 보여줘야
                                     화면 가장자리의 민감정보를 놓치지 않고 모자이크로 가릴 수 있다. -->
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                <Canvas x:Name="PrivacyMaskCanvas" Panel.ZIndex="2" Background="Transparent"
                                        IsHitTestVisible="False"
                                        MouseLeftButtonDown="PrivacyMaskCanvas_MouseLeftButtonDown"
                                        MouseMove="PrivacyMaskCanvas_MouseMove"
                                        MouseLeftButtonUp="PrivacyMaskCanvas_MouseLeftButtonUp"
                                        SizeChanged="PrivacyMaskCanvas_SizeChanged"/>
                                <!-- 오버레이 위치를 OBS처럼 미리보기 위에서 직접 마우스로 끌어서 잡을 수 있게
                                     하는 레이어. Background를 일부러 비워 둔다(투명이 아니라 "없음") —
                                     그래야 상자가 없는 빈 곳을 클릭했을 때는 이 캔버스가 클릭을 가로채지
                                     않고 그대로 통과시켜서 민감정보 모자이크 편집 등 다른 조작을 막지
                                     않는다. 상자(각 오버레이)와 크기 조절 손잡이만 각자 직접 클릭/드래그를
                                     받는다. -->
                                <Canvas x:Name="OverlayAdornerCanvas" Panel.ZIndex="4" SizeChanged="OverlayAdornerCanvas_SizeChanged"/>
                                <StackPanel x:Name="PreviewEmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="66" Height="54" CornerRadius="12" BorderBrush="#536078" BorderThickness="1.5" Background="#172033">
                                        <Grid>
                                            <Rectangle Width="33" Height="20" RadiusX="3" Stroke="#77849B" StrokeThickness="2"/>
                                            <Path Data="M 25,34 L 41,34 M 33,27 L 33,34" Stroke="#77849B" StrokeThickness="2"/>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="방송할 증권 차트 창을 선택하세요" Foreground="#D4DAE5" FontWeight="SemiBold"
                                               FontSize="13" Margin="0,14,0,0" HorizontalAlignment="Center"/>
                                    <TextBlock Text="차트 화면이 이곳에 실시간으로 표시됩니다" Foreground="#748096"
                                               FontSize="10.5" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Border x:Name="LiveOverlay" Panel.ZIndex="3" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="14" Background="#D91F2937" CornerRadius="6" Padding="9,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#FF4268" Margin="0,0,6,0"/>
                                        <TextBlock Text="LIVE" Foreground="White" FontWeight="Bold" FontSize="10"/>
                                        <TextBlock x:Name="ElapsedText" Text="00:00:00" Foreground="#E4E7EC" FontSize="10" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#28C76F" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="방송할 창과 서버 정보를 설정해 주세요" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" FontSize="12.5" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="StatusDetailText" Text="선택한 화면은 방송 시작 전에 미리 확인할 수 있습니다."
                                       Foreground="{StaticResource Muted}" FontSize="10.5" Margin="17,6,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="SaveSettingsButton" Content="설정 저장" Style="{StaticResource SecondaryButton}"
                                VerticalAlignment="Center" Click="SaveSettingsButton_Click"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                        <TextBlock Text="방송 설정" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="차트 화면과 송출 정보를 설정합니다" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,3,0,12"/>

                        <TextBlock Text="방송할 차트 화면" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="72"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WindowCombo" Style="{StaticResource Input}" DisplayMemberPath="DisplayName"
                                      SelectionChanged="WindowCombo_SelectionChanged" Margin="0,0,7,0"/>
                            <Button Grid.Column="1" Content="↻" FontSize="17" Padding="0" Margin="0,0,5,0"
                                    Style="{StaticResource SecondaryButton}" Click="RefreshWindowsButton_Click"/>
                            <Button Grid.Column="2" x:Name="SelectRegionButton" Content="영역 지정" Padding="6,0"
                                    Style="{StaticResource SecondaryButton}" Click="SelectRegionButton_Click"/>
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="74"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="PrivacyMaskToggle" Content="▦ 민감정보 모자이크" Style="{StaticResource PrivacyToggle}"
                                          Margin="0,0,7,0" Checked="PrivacyMaskToggle_Checked" Unchecked="PrivacyMaskToggle_Unchecked"/>
                            <Button Grid.Column="1" x:Name="ClearPrivacyMasksButton" Content="전체 삭제"
                                    Style="{StaticResource SecondaryButton}" Height="32" Padding="6,0"
                                    Click="ClearPrivacyMasksButton_Click"/>
                        </Grid>

                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="오버레이로 추가 표시" Style="{StaticResource Label}" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="AddOverlayButton" Content="오버레이 추가" Padding="4,0"
                                    Style="{StaticResource SecondaryButton}" Click="AddOverlayButton_Click"/>
                        </Grid>
                        <TextBlock Text="챠트 화면 위에 다른 창의 일부를 작게 띄워 보여줍니다. 그 창을 옮기거나 크기를 바꿔도 오버레이가 따라갑니다."
                                   Foreground="{StaticResource Muted}" FontSize="9.5" Margin="0,2,0,6" TextWrapping="Wrap"/>
                        <ListBox x:Name="OverlayListBox" Style="{StaticResource Input}" Height="72" Padding="4"
                                 DisplayMemberPath="Summary"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="74"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="목록에서 선택한 뒤 삭제할 수 있습니다" FontSize="9.5"
                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="RemoveOverlayButton" Content="삭제" Padding="6,0"
                                    Style="{StaticResource SecondaryButton}" Height="28" Click="RemoveOverlayButton_Click"/>
                        </Grid>

                        <Separator Background="{StaticResource Line}" Margin="0,8,0,7"/>

                        <TextBlock Text="영상 품질" Style="{StaticResource Label}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ResolutionCombo" Style="{StaticResource Input}" SelectedIndex="1">
                                <ComboBoxItem Content="720p (용량 절약)" Tag="720"/>
                                <ComboBoxItem Content="최대 1080p (선명 · 권장)" Tag="1080"/>
                            </ComboBox>
                            <ComboBox Grid.Column="2" x:Name="FrameRateCombo" Style="{StaticResource Input}" SelectedIndex="1">
                                <ComboBoxItem Content="24 fps (PC 사양이 낮을 때)" Tag="24"/>
                                <ComboBoxItem Content="30 fps" Tag="30"/>
                                <ComboBoxItem Content="60 fps" Tag="60"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="마이크" Style="{StaticResource Label}" Margin="0,9,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="38"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="UseMicCheck" IsChecked="True" VerticalAlignment="Center" Margin="0,0,9,0"
                                      Checked="UseMicCheck_Changed" Unchecked="UseMicCheck_Changed"/>
                            <ComboBox Grid.Column="1" x:Name="AudioDeviceCombo" Style="{StaticResource Input}" DisplayMemberPath="DisplayName"
                                      Margin="0,0,7,0" SelectionChanged="AudioDeviceCombo_SelectionChanged"/>
                            <Button Grid.Column="2" Content="↻" FontSize="17" Style="{StaticResource SecondaryButton}" Padding="0"
                                    Click="RefreshAudioButton_Click"/>
                        </Grid>
                        <Border x:Name="MicLevelTrack" Height="7" CornerRadius="4" Background="#EEF1F6" Margin="0,7,0,0">
                            <Border x:Name="MicLevelFill" Width="0" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#635BFF" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="0.6"/>
                                        <GradientStop Color="#EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <TextBlock Text="PC 소리 (음악 등)" Style="{StaticResource Label}" Margin="0,9,0,6"/>
                        <CheckBox x:Name="UseSecondaryAudioCheck" Content="현재 스피커로 나가는 소리를 마이크와 함께 방송"
                                  IsChecked="False" VerticalAlignment="Center"
                                  Checked="UseSecondaryAudioCheck_Changed" Unchecked="UseSecondaryAudioCheck_Changed"/>
                        <TextBlock Text="별도 장치 설정 없이 현재 기본 재생 장치의 소리를 그대로 함께 내보냅니다." FontSize="9.5"
                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <Border x:Name="SystemLevelTrack" Height="7" CornerRadius="4" Background="#EEF1F6" Margin="0,8,0,0">
                            <Border x:Name="SystemLevelFill" Width="0" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#635BFF" Offset="0"/>
                                        <GradientStop Color="#8B5CF6" Offset="0.6"/>
                                        <GradientStop Color="#EC4899" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Border>

                        <TextBlock Text="녹화" Style="{StaticResource Label}" Margin="0,9,0,6"/>
                        <Grid x:Name="RecordingFolderPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="RecordingFolderBox" Style="{StaticResource Input}" IsReadOnly="True"/>
                            <Button Grid.Column="2" Content="폴더 선택" Style="{StaticResource SecondaryButton}" Padding="10,0"
                                    Click="ChooseRecordingFolderButton_Click"/>
                        </Grid>
                        <TextBlock Text="방송 중에 아래 '녹화 시작' 버튼으로 켜고 끌 수 있습니다. 녹화를 멈추면 위 폴더에 자동으로 업로드 가능한 mp4로 저장됩니다."
                                   FontSize="9.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <Grid Margin="0,8,0,0">
                            <Button x:Name="RecordingStartButton" Content="●  녹화 시작" Style="{StaticResource RecordingStartButtonStyle}"
                                    Height="38" FontSize="12.5" IsEnabled="False" Click="RecordingStartButton_Click"/>
                            <Button x:Name="RecordingStopButton" Content="■  녹화 중지" Style="{StaticResource StopButton}"
                                    Height="38" FontSize="12.5" Visibility="Collapsed" Click="RecordingStopButton_Click"/>
                        </Grid>
                        <TextBlock x:Name="RecordingStatusText" Text="" FontSize="9.5" Foreground="{StaticResource Muted}"
                                   Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <Separator Background="{StaticResource Line}" Margin="0,8,0,7"/>

