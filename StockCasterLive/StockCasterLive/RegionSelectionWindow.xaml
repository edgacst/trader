<Window x:Class="StockCasterLive.RegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#58070A12"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Cursor="Cross"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="OverlayCanvas" Background="Transparent" Cursor="Cross"
            MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
            MouseMove="OverlayCanvas_MouseMove"
            MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp">
        <Rectangle x:Name="SelectionRectangle" Visibility="Collapsed"
                   Stroke="#7CF6D2" StrokeThickness="2"
                   Fill="#247CF6D2"/>

        <Border x:Name="GuidePanel" Canvas.Left="28" Canvas.Top="28"
                Background="#E8151926" BorderBrush="#40FFFFFF" BorderThickness="1"
                CornerRadius="12" Padding="16,12">
            <StackPanel>
                <TextBlock Text="방송할 영역을 드래그하세요" Foreground="White"
                           FontSize="16" FontWeight="Bold"/>
                <TextBlock Text="차트 화면의 필요한 부분만 선택할 수 있습니다  ·  ESC 취소"
                           Foreground="#C7CEDD" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border x:Name="SizeBadge" Visibility="Collapsed"
                Background="#E8171A2C" BorderBrush="#7CF6D2" BorderThickness="1"
                CornerRadius="7" Padding="9,5">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
        </Border>
    </Canvas>
</Window>
